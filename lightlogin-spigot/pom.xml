                            <!--
                              Relocation rule: never relocate a library that ships
                              META-INF/versions/** (multi-release) content. Shade rewrites the class
                              files and the resources it copies, but it does NOT rewrite the
                              META-INF/versions/N/... copies, so a relocated multi-release library
                              ends up with two inconsistent halves and fails at runtime
                              (observed: sqlite-jdbc -> NoClassDefFoundError on NativeDB, which
                              surfaces as UnsatisfiedLinkError on the server).

                              Every library below, BouncyCastle included, is relocated into
                              dev.lightlogin.libs so it cannot collide with another plugin's copy in
                              the shared namespace. BouncyCastle is only safe to relocate because the
                              build filters it down to base classes and the jar is asserted to carry
                              no META-INF/versions content at all; shipped whole, its multi-release
                              half made relocation impossible.
                            -->
                            <relocations>
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>dev.lightlogin.libs.com.zaxxer.hikari</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.eclipse.angus</pattern>
                                    <shadedPattern>dev.lightlogin.libs.org.eclipse.angus</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>jakarta.mail</pattern>
                                    <shadedPattern>dev.lightlogin.libs.jakarta.mail</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>jakarta.activation</pattern>
                                    <shadedPattern>dev.lightlogin.libs.jakarta.activation</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.slf4j</pattern>
                                    <shadedPattern>dev.lightlogin.libs.org.slf4j</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.bouncycastle</pattern>
                                    <shadedPattern>dev.lightlogin.libs.org.bouncycastle</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <!--
                                  Merge and rewrite META-INF/services/* so the service files agree
                                  with the relocations above. Without this, later jars overwrite
                                  earlier ones and every provider but one is lost.
                                -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
